  "files": [
    "dist",
    "tailwind.config.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:debug": "bash ./scripts/bash/build-debug.sh",
    "build:debug:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/powershell/build-debug.ps1",
    "build:release": "bash ./scripts/bash/build-release.sh",
    "build:release:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/powershell/build-release.ps1",
    "check": "bash ./scripts/bash/check.sh",
    "check:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/powershell/check.ps1",
    "check:docs": "bash ./tools/docs/check-docs.sh",
    "check:repo": "bash ./tools/repo/check-hygiene.sh",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\" \"*.{ts,js,json}\"",
    "typecheck": "tsc -p ./jsconfig.json",
    "pack": "pnpm pack --pack-destination ./package",
    "pack:inspect": "bash ./tools/package/inspect-pack.sh",
    "backup": "bash ./scripts/bash/backup/full-repo-backup.sh",
    "backup:cloud": "bash ./scripts/bash/backup/sync-google-drive.sh",
    "backup:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/powershell/backup/full-repo-backup.ps1",
    "security:manifest": "bash ./scripts/bash/security/generate-manifest.sh",
    "security:manifest:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/powershell/security/generate-manifest.ps1",
    "security:verify": "bash ./scripts/bash/security/verify-manifest.sh",
    "security:verify:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/powershell/security/verify-manifest.ps1",
    "restore:list": "bash ./scripts/bash/backup/full-repo-restore.sh --list",
    "restore:list:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/powershell/backup/full-repo-restore.ps1 -List",
    "preview": "vite preview",
    "demo": "bash ./scripts/bash/dev.sh",
    "demo:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/powershell/dev.ps1",
    "publish:sdk": "bash ./scripts/bash/publish-sdk.sh",
    "publish:sdk:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/powershell/publish-sdk.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
